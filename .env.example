GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Layer 8 (LiteLLM gateway) — added Phase 2, Wk 14
# Any non-empty string works as a local dev master key; it just has to match
# between the gateway and the AI chains calling it.
LITELLM_MASTER_KEY=sk-finlineage-local-dev
# Host runs (venv, per Section 13) hit the gateway on localhost; the Docker
# Compose file overrides this to http://litellm-gateway:4000 for in-network calls.
LITELLM_BASE_URL=http://localhost:4000
